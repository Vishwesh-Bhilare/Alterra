 void MainWindow::onBrowseModel() {
     QString path = QFileDialog::getOpenFileName(this, "Select model checkpoint", QString(), "SB3 checkpoint (*.zip)");
     if (!path.isEmpty()) {
         modelPathEdit_->setText(path);
     }
 }
 
